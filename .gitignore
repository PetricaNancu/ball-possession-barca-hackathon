# This repository is public. The match data is licensed for the competition only and must
# never be committed, nor anything that would reconstruct it (frame-level exports, clips).
data/
cache/
corpus/*
!corpus/noise_targets.json
*.mp4
*.parquet
*.pkl
*.pl3container
*.gzip
# .npz caches are large and regenerable; the fitted noise model is small and part of the method
cache/*.npz
corpus/*.npz
!models/*.npz
*.log

# Private ground truth, should it ever land here by mistake
*_possession_gt.csv
*_possession_gt_meta.json
*_possession_gt_reference.csv

# Generated by the (vendored) scorer
vendor/mtah2027/evaluation/reports/
vendor/mtah2027/evaluation/scoreboard.csv

